# The test environment observed in the supplied HAR. Override for other environments.
API_BASE_URL=https://test-meine.wienenergie.at

# Logging verbosity: trace, debug, info, warn, error, fatal, or silent.
LOG_LEVEL=info

# Optional. If set, this token is used instead of browser login.
API_BEARER_TOKEN=

# Browser-login credentials used to capture the app's outgoing Bearer header when
# API_BEARER_TOKEN is unset. Store these only in your local .env or CI secrets.
API_TEST_USER=mac-all
KS_ADMIN_PASSWORD=
MAC_ALL_PASSWORD=
SG_SCHREIBER_PASSWORD=
WAERME_SCHREIBER_PASSWORD=
TANKE_SCHREIBER_PASSWORD=
SUPERSCHNELL_SCHREIBER_PASSWORD=
